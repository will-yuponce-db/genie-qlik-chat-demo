# Copy to .env (gitignored) and fill in. Do NOT commit real values.

# Target Genie space (32-hex id from the Genie space URL)
GENIE_SPACE_ID=

# --- Production: service principal OAuth (M2M) -------------------------------
# The SP needs CAN_RUN on the Genie space and CAN_USE on its SQL warehouse. Nothing else.
DATABRICKS_HOST=https://<your-frm-workspace>.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=

# --- Local dev alternative: use a CLI profile instead of the SP vars above ---
# DATABRICKS_CONFIG_PROFILE=fe-sandbox-will-wy-frm

# Restrict to the Qlik Cloud tenant origin in production (comma-separated).
# Default "*" is for local demo only.
ALLOWED_ORIGINS=*
